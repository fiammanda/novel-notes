{
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/data.js", "destination": "/api" },
    { "source": "/img/:id", "destination": "/api" },
    { "source": "/import", "destination": "/index.html" },
    { "source": "/:id([0-9a-z]{10})", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/data/update",
      "schedule": "0 5 * * *"
    }
  ]
}